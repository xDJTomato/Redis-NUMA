{
    // ────────────────────────────────────────────────────────────────
    // composite_lru.json - retired: reference only, no longer consumed by
    // the kernel.
    //
    // The native numa_composite_lru module and its numa-migrate-config /
    // NUMA CONFIG LOAD entry points have been retired; Composite LRU now
    // lives exclusively as a NUMAflow atomic-op preset
    // (numaflow/src/nf_strategy.c's build_composite_lru), selectable via
    // `numa-flow-default-strategy composite_lru` in redis.conf or at
    // runtime via `NUMA FLOW DEFAULT composite_lru`. This file documents
    // the field names/semantics the old native implementation used; it is
    // kept as a reference for writing custom NUMAflow workflow JSON, not
    // as something Redis reads directly.
    //
    // All fields are optional; unset fields keep the built-in defaults.
    // ────────────────────────────────────────────────────────────────

    // -- Hotness decay --------------------------------------------------------
    // Minimum trigger interval of the lazy staircase decay (seconds).
    // A key is only decayed after being idle for at least decay_threshold_sec
    // seconds since its last access. Smaller values decay more aggressively but
    // may cause frequent hot-spot recomputation.
    // Range: 1 ~ 3600   Default: 10
    "decay_threshold_sec": 10,

    // -- Migration trigger threshold ------------------------------------------
    // When a key's hotness level reaches this value, the candidate pool fast
    // channel triggers migration evaluation. Hotness ranges 0-7 (tracked by the
    // PREFIX mechanism); lower values migrate more aggressively.
    // Range: 1 ~ 7   Code default: 3 (explicitly lowered to 1 here for more aggressive migration)
    "migrate_hotness_threshold": 1,

    // -- Stability count ------------------------------------------------------
    // On the dictionary fallback path (non-PREFIX scenarios), a key must keep
    // satisfying the migration conditions for stability_count consecutive
    // checks before migration actually fires, preventing flapping.
    // Range: 1 ~ 255   Default: 3
    "stability_count": 3,

    // -- Candidate pool capacity ----------------------------------------------
    // Ring buffer capacity of the hot candidate pool (fast channel), in entries.
    // Recommended: peak_hot_keys * 1.5.
    //   - Too small: hot keys get overwritten, migration latency increases
    //   - Too large: more memory overhead with diminishing returns
    // Suitable sizes:
    //   Small instances (< 1M keys): 256
    //   Medium instances (1-10M keys): 512 ~ 1024
    //   Large instances (> 10M keys): 2048+
    // Range: 1 ~ 65535   Code default: 1024
    "hot_candidates_size": 1024,

    // -- Progressive scan batch size ------------------------------------------
    // Fallback channel: number of keys scanned per serverCron tick.
    // Larger values sweep the database faster but cost more CPU per tick.
    // Suggested: DBSIZE / 100 ~ DBSIZE / 50 (full coverage in ~50-100 cron rounds)
    //   - 100K keys: 200 ~ 400
    //   - 1M keys: 2000 ~ 5000
    // Range: 1 ~ 65535   Default: 2500
    "scan_batch_size": 2500,

    // -- Base migration rate multiplier ---------------------------------------
    // Scales up both the fast-channel migration budget and the fallback scan
    // budget without changing Composite-LRU's candidate/hotness/resource-check
    // logic. The default 5 means about 5x the original base migration rate; can
    // be adjusted at runtime via NUMA CONFIG SET migration_rate_multiplier N.
    // Range: 1 ~ 100   Default: 5
    "migration_rate_multiplier": 5,

    // -- Resource pressure thresholds (0.0 ~ 1.0) ------------------------------
    // The following three thresholds control the resource protection logic of
    // migration execution. When exceeded, migration candidates are deferred
    // instead of being executed immediately.

    // Node memory utilization cap; above it the node is considered "overloaded"
    // and migrations into it stop.
    // Range: 0.5 ~ 1.0   Default: 0.8
    // Note: on the QEMU setup Node 0 has only 4GB, so 0.8 is hit mid-Phase 2 and
    //       blocks all further migrations. Raised to 0.95 to match the small
    //       memory node scenario.
    "overload_threshold": 0.95,

    // Node bandwidth utilization cap; above it the node is considered "bandwidth
    // saturated" and migration traffic is limited.
    // Range: 0.5 ~ 1.0   Default: 0.9
    "bandwidth_threshold": 0.9,

    // System-wide migration pressure cap; above it the system enters a
    // conservative mode (reduced migration rate).
    // Range: 0.3 ~ 1.0   Default: 0.7
    // Raised in sync with overload_threshold=0.95
    "pressure_threshold": 0.85,

    // -- Background auto migration switch --------------------------------------
    // 1 = enabled (recommended for production): serverCron drives the candidate
    //     pool plus the progressive scan automatically
    // 0 = disabled: manual triggers only (NUMA MIGRATE KEY / NUMA MIGRATE SCAN),
    //     for testing, debugging, or scenarios with strict migration timing
    // Default: 1
    "auto_migrate_enabled": 1,

    // -- Debug logging switch --------------------------------------------------
    // 1 = print key migration-decision logs (access/resource/fast-path/scan/key-migrate)
    // 0 = debug logging off
    // Default: 0
    "debug_logging_enabled": 0,

    // -- Per-node max bandwidth (MB/s) -----------------------------------------
    // C-TAP measured baseline bandwidth, used for bandwidth utilization.
    // Node 0 (local/DRAM): typical 51000 MB/s (~51 GB/s)
    // Node 1 (CXL memory): typical 12000 MB/s (~12 GB/s)
    // Note: consistent with the README node definitions (Node 0=DRAM, Node 1=CXL);
    // an older version had them swapped, which reversed the bandwidth decisions.
    // Adjust according to the actual hardware.
    "max_bandwidth_node0_mbps": 51000,
    "max_bandwidth_node1_mbps": 12000
}
